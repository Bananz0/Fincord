[Unit]
Description=Accord Enhanced LRC encrypted tunnel to Phastos
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=glenm
ExecStart=/usr/bin/ssh -N -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -L 0.0.0.0:18097:127.0.0.1:8097 phastos
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
