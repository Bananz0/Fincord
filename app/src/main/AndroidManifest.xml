<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Talk to the Jellyfin server: library metadata, streaming, artwork -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- ExoPlayer uses this to react to connectivity changes while streaming -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Best-effort Wi-Fi name for associating a tested LAN URL; this is a normal permission. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Run music playback service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
        android:minSdkVersion="34" />
    <!-- Run the offline download service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- PlatformScheduler requires this to re-register its jobs after a reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Requested lazily from the quality sheet, solely to read the negotiated A2DP codec. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        android:usesPermissionFlags="neverForLocation" />

    <!--
        No media permissions. The library is the Jellyfin server and nothing else, so there is
        nothing on the device to read - and a music app that asks for storage access it never uses
        is asking the user to take a claim on trust. The profile picture uses PickVisualMedia,
        which hands back a single chosen image without any permission at all.
    -->

    <application
        android:name="org.akanework.gramophone.logic.GramophoneApplication"
        android:allowBackup="true"
        android:appCategory="audio"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Gramophone"
        android:windowSoftInputMode="adjustResize"
        tools:targetApi="upside_down_cake">

        <!--
            Google Cast reads this reflectively to find Fincord's CastOptions. Without it the
            framework throws on first use rather than simply finding no devices.
        -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="uk.akane.accord.logic.cast.CastOptionsProvider" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.shared-media"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/shared_media_paths" />
        </provider>

        <activity
            android:name="org.akanework.gramophone.ui.BugHandlerActivity"
            android:exported="false" />

        <service
            android:name="org.akanework.gramophone.logic.GramophonePlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService" />
                <action android:name="androidx.media3.session.MediaLibraryService" />
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
            Offline downloads. exported=false because nothing outside the app should be able to
            queue work here; media3 starts it through an explicit intent.
        -->
        <service
            android:name="org.akanework.gramophone.logic.GramophoneDownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync">
            <intent-filter>
                <action android:name="androidx.media3.exoplayer.downloadService.action.RESTART" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- PlatformScheduler resumes interrupted downloads through JobScheduler. -->
        <service
            android:name="androidx.media3.exoplayer.scheduler.PlatformScheduler$PlatformSchedulerService"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!--
            Catches Spotify's OAuth redirect. exported=true is required - the browser is what
            delivers the intent - but it only ever carries an authorisation code that is useless
            without the PKCE verifier held inside the app.
        -->
        <activity
            android:name="org.akanework.gramophone.ui.SpotifyAuthActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="spotify-callback"
                    android:scheme="fincord" />
            </intent-filter>
        </activity>

        <activity
            android:name="org.akanework.gramophone.ui.JellyfinLoginActivity"
            android:exported="false"
            android:label="@string/jellyfin_login_title"
            android:windowSoftInputMode="adjustResize" />

        <!--
            The launcher is now Fincord's own activity: a shrinking card holding a Cupertino
            FragmentSwitcherView, with the player as a floating panel over it, in place of the
            bottom-sheet-and-BottomNavigationView shell below. It declares
            enableOnBackInvokedCallback because it drives predictive back itself, both to collapse
            the now-playing panel and to run the switcher's back transition; the application element
            still opts out for the older screens.
        -->
        <activity
            android:name="uk.akane.accord.ui.MainActivity"
            android:enableOnBackInvokedCallback="true"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Accord.Splash"
            android:windowSoftInputMode="adjustNothing">
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.MUSIC_PLAYER" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.APP_MUSIC" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!--
                Fincord in the share sheet. Sharing an album from Spotify, Deezer or Apple Music
                hands over a plain URL, which the request screen resolves and asks the user's
                downloader for - the shortest path there is from hearing a record elsewhere to
                owning it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>

            <!-- A saved settings file can be restored by tapping it in a document provider. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:mimeType="application/vnd.fincord.settings"
                    android:scheme="content" />
            </intent-filter>

            <!--
                Cast's remote-control notification opens Fincord with this URI so another sender
                can join the already-running Fincord receiver session. The same URI and the
                release package name must be registered for the receiver in the Cast console.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="cast"
                    android:path="/join"
                    android:scheme="fincord" />
            </intent-filter>

            <!--
                Exact playback shortcuts return here.

                Separate from the search filter below, and it has to stay separate. Android merges
                every <data> element inside one filter combinatorially rather than treating each as
                a URI pattern of its own, so a single filter holding both of these demanded the
                /item/ path prefix of the search host too - and fincord://search, which carries no
                path at all, then matched nothing. That silently killed the Assistant capability:
                the url-template in shortcuts.xml pointed at a URI the system could not resolve.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="play"
                    android:pathPrefix="/item/"
                    android:scheme="fincord" />
            </intent-filter>

            <!-- Assistant GET_THING searches and in-app search links. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="search"
                    android:scheme="fincord" />
            </intent-filter>
        </activity>

        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <!--
            Required for the system Output Switcher on Android 13+: without this receiver the
            notification's output picker cannot hand playback between this phone and a receiver,
            and remote-to-local transfers never reach the app at all.
        -->
        <receiver
            android:name="androidx.mediarouter.media.MediaTransferReceiver"
            android:exported="true" />
    </application>

</manifest>
