<?xml version="1.0" encoding="utf-8"?>
<!--
    Circular translucent backing for the header action buttons, matching the upstream Accord
    navigation bar. The tint comes from navigationBarEllipsisBackground rather than a theme colour
    so it stays consistent over both light and dark surfaces.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/navigationBarEllipsisBackground" />
        </shape>
    </item>
</ripple>
