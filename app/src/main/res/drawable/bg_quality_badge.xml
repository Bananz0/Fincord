<?xml version="1.0" encoding="utf-8"?>
<!--
    Outline rather than a filled pill: the badge sits over album-art-tinted backgrounds in the full
    player, where a solid fill fights whatever colour is behind it.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="4dp" />
    <stroke
        android:width="1dp"
        android:color="@color/onSurfaceColorInactive" />
</shape>
