<?xml version="1.0" encoding="utf-8"?>
<!--
    Stemmed earbuds - AirPods, Galaxy Buds3 Pro. Drawn here rather than lifted from a manufacturer's
    app so the build carries no third-party product artwork; AudioOutput picks between this and the
    stemless shape by device name.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- Left bud: the housing that sits in the ear, and a short stem below it. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M3.2,7.2a3.8,3.8 0 1,0 7.6,0a3.8,3.8 0 1,0 -7.6,0Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M5.7,9.6h2.6v6.6a1.3,1.3 0 0,1 -2.6,0Z" />

    <!-- Right bud. -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M13.2,7.2a3.8,3.8 0 1,0 7.6,0a3.8,3.8 0 1,0 -7.6,0Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M15.7,9.6h2.6v6.6a1.3,1.3 0 0,1 -2.6,0Z" />

</vector>
