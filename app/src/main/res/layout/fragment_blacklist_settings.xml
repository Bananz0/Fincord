<?xml version="1.0" encoding="utf-8"?>
<!--
    Hidden music, in the same shape as every other settings screen.

    It used to be a CoordinatorLayout with a collapsing Material toolbar - the only screen in the
    app still built that way - so it had a bare back arrow where everything else has "‹ Settings",
    and naked rows where everything else has a grouped card.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <!-- Content is declared first so the collapsing navigation surface always paints above it. -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="22dp"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hasLargeMenuItems="false"
        app:hasReturnButton="true"
        app:layout_constraintTop_toTopOf="parent"
        app:returnButtonText="@string/settings"
        app:title="@string/settings_blacklist_folder">

        <!--
            NavigationBar owns this child so the title and search field collapse as one surface.
            Keeping the field as a sibling left it at its original constraint position while the
            bar translated upward, which made the two controls pass through each other.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/blacklist_filter_container"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginHorizontal="22dp"
            android:layout_marginBottom="15dp"
            android:background="@drawable/search_bar_background">

            <ImageView
                android:id="@+id/blacklist_filter_icon"
                android:layout_width="19dp"
                android:layout_height="19dp"
                android:layout_marginStart="10dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_magnifying_glass"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/labels_tertiary" />

            <EditText
                android:id="@+id/blacklist_filter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="16dp"
                android:autofillHints=""
                android:background="@null"
                android:fontFamily="@font/inter_medium"
                android:hint="@string/blacklist_filter_hint"
                android:inputType="text"
                android:singleLine="true"
                android:textColor="@color/onSurfaceColor"
                android:textColorHint="@color/labels_tertiary"
                android:textSize="18sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/blacklist_filter_icon"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </uk.akane.accord.ui.components.NavigationBar>

</androidx.constraintlayout.widget.ConstraintLayout>
