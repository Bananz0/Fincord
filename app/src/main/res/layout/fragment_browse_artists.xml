<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/category_artists"
        app:hasLargeMenuItems="true"
        app:hasReturnButton="true"
        app:returnButtonText="@string/bottom_nav_library">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/layout_search_bar" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/artist_tab_container"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginHorizontal="22dp"
                android:layout_marginBottom="15dp"
                android:padding="4dp"
                app:cardBackgroundColor="@color/tabContainerColor"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardPreventCornerOverlap="false"
                app:cardUseCompatPadding="false">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="0dp">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/artist_tab_indicator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_gravity="start"
                        android:layout_margin="3dp"
                        android:outlineAmbientShadowColor="@color/searchTabShadowAmbientColor"
                        android:outlineSpotShadowColor="@color/searchTabShadowColor"
                        app:cardBackgroundColor="@color/tabSelectedColor"
                        app:cardCornerRadius="10dp"
                        app:cardElevation="4dp"
                        app:cardPreventCornerOverlap="false"
                        app:cardUseCompatPadding="false" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:elevation="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/artist_mode_main"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/main_artists"
                            android:textColor="@color/onSurfaceColor"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/artist_mode_featured"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/inter_semibold"
                            android:gravity="center"
                            android:includeFontPadding="false"
                            android:text="@string/featured_artists"
                            android:textColor="@color/onSurfaceColorInactive"
                            android:textSize="13sp" />
                    </LinearLayout>
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

    </uk.akane.accord.ui.components.NavigationBar>

</androidx.constraintlayout.widget.ConstraintLayout>
