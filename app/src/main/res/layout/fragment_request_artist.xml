<?xml version="1.0" encoding="utf-8"?>
<!--
    One artist as a downloader sees them.

    Deliberately the library's own artist page, structure for structure: the same tall header, the
    same latest-release card, the same "Albums" carousel, and a list below it. Only the meaning of
    the list differs - here it is everything they released, owned or not - and a page that looked
    like a different app for that one difference would be the wrong trade.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surfaceColor">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/headerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/ivHeaderArt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/category_artists"
                    android:scaleType="centerCrop"
                    android:src="@drawable/default_cover" />

                <View
                    android:id="@+id/vHeaderGradient"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_header_bottom_fade" />

                <TextView
                    android:id="@+id/tvArtistName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginEnd="16dp"
                    android:layout_marginBottom="20dp"
                    android:fontFamily="@font/inter_bold"
                    android:includeFontPadding="false"
                    android:textColor="@android:color/white"
                    android:textSize="32sp"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="Chxrry" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/latestCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="16dp"
                app:cardBackgroundColor="@color/surfaceColor"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="0dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="0dp"
                    android:paddingBottom="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/ivLatestCover"
                        style="@style/Widget.Accord.BottomNavigation.BottomSheet.Preview.Cover"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:contentDescription="@string/category_albums"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_cover"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvLatestDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/onSurfaceColorInactive"
                        android:textSize="12sp"
                        app:layout_constraintEnd_toStartOf="@id/btnLatestAdd"
                        app:layout_constraintStart_toEndOf="@id/ivLatestCover"
                        app:layout_constraintTop_toTopOf="@id/ivLatestCover"
                        tools:text="Latest release" />

                    <TextView
                        android:id="@+id/tvLatestTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/inter_semibold"
                        android:includeFontPadding="false"
                        android:textColor="@color/onSurfaceColor"
                        android:textSize="18sp"
                        app:layout_constraintEnd_toStartOf="@id/btnLatestAdd"
                        app:layout_constraintStart_toEndOf="@id/ivLatestCover"
                        app:layout_constraintTop_toBottomOf="@id/tvLatestDate"
                        tools:text="U, Me &amp; My Ego" />

                    <TextView
                        android:id="@+id/tvLatestCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginTop="4dp"
                        android:includeFontPadding="false"
                        android:textColor="@color/onSurfaceColorInactive"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toStartOf="@id/btnLatestAdd"
                        app:layout_constraintStart_toEndOf="@id/ivLatestCover"
                        app:layout_constraintTop_toBottomOf="@id/tvLatestTitle"
                        tools:text="2026 · In your library" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnLatestAdd"
                        style="@style/Widget.Accord.ActionButton"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="0dp"
                        android:contentDescription="@string/lidarr_request_missing"
                        app:backgroundTint="@color/navigationBarEllipsisBackground"
                        app:icon="@drawable/ic_plus"
                        app:iconSize="22dp"
                        app:iconTint="@color/accentColor"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvAlbumsHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:fontFamily="@font/inter_semibold"
                android:includeFontPadding="false"
                android:text="@string/category_albums"
                android:textColor="@color/onSurfaceColor"
                android:textSize="20sp" />

            <uk.akane.accord.ui.components.TwoAxisRecyclerView
                android:id="@+id/rvAlbums"
                android:layout_width="match_parent"
                android:layout_height="230dp"
                android:clipToPadding="false"
                android:nestedScrollingEnabled="false"
                android:orientation="horizontal"
                android:overScrollMode="never"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <LinearLayout
                android:id="@+id/releasesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvReleases"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/inter_semibold"
                    android:includeFontPadding="false"
                    android:text="@string/requests_artist_all_releases"
                    android:textColor="@color/onSurfaceColor"
                    android:textSize="20sp" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/artist_progress"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:indeterminate="true"
                    android:visibility="gone"
                    app:indicatorColor="@color/accentColor"
                    app:indicatorInset="0dp"
                    app:indicatorSize="16dp"
                    app:trackThickness="2dp"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/artist_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/inter_regular"
                    android:includeFontPadding="false"
                    android:textColor="@color/onSurfaceColorInactive"
                    android:textSize="14sp"
                    tools:text="13 releases" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/artist_releases"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:paddingBottom="@dimen/bottom_nav_height" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:expandedAccentColor="@android:color/white"
        app:hasExpandedTitle="false"
        app:hasLargeMenuItems="true"
        app:hasReturnButton="true"
        app:layout_constraintTop_toTopOf="parent"
        app:returnButtonText="@string/category_artists"
        app:title=""
        app:transparentExpandedBackground="true" />

</androidx.constraintlayout.widget.ConstraintLayout>
