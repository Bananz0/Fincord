<?xml version="1.0" encoding="utf-8"?>
<!--
    Ask Lidarr for music you do not have: search it by name, or paste a playlist link and request
    everything on it that is missing.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/requests_title" />

    <EditText
        android:id="@+id/request_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="22dp"
        android:layout_marginTop="8dp"
        android:autofillHints=""
        android:background="@drawable/search_bar_background"
        android:fontFamily="@font/inter_regular"
        android:hint="@string/requests_search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:singleLine="true"
        android:textColor="@color/onSurfaceColor"
        android:textColorHint="@color/onSurfaceColorInactive"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigation_bar" />

    <!--
        Sits on the status line rather than over the list, so a search in progress does not hide
        the results of the last one.
    -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/request_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="22dp"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/accentColor"
        app:indicatorInset="0dp"
        app:indicatorSize="16dp"
        app:layout_constraintBottom_toBottomOf="@id/request_status"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/request_status"
        app:trackThickness="2dp"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/request_status"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="22dp"
        android:layout_marginTop="10dp"
        android:fontFamily="@font/inter_regular"
        android:includeFontPadding="false"
        android:textColor="@color/onSurfaceColorInactive"
        android:textSize="14sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/request_progress"
        app:layout_constraintTop_toBottomOf="@id/request_query"
        app:layout_goneMarginStart="22dp"
        tools:text="Requested 12 of 18 tracks"
        tools:visibility="visible" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/request_results"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:layout_marginTop="8dp"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/request_status" />

</androidx.constraintlayout.widget.ConstraintLayout>
