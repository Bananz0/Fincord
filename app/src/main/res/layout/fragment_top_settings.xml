<?xml version="1.0" encoding="utf-8"?>
<!--
    Every settings child uses Accord's own navigation bar. The preference list fills the screen
    behind it; NavigationBar attaches to that RecyclerView and supplies the top/bottom insets, the
    same arrangement used by the original settings screens.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/settings"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hasLargeMenuItems="false"
        app:hasReturnButton="true"
        app:layout_constraintTop_toTopOf="parent"
        app:returnButtonText="@string/settings" />

</androidx.constraintlayout.widget.ConstraintLayout>
