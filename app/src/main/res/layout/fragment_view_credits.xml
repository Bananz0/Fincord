<?xml version="1.0" encoding="utf-8"?>
<!--
    The credits behind the playing track. Sections are built in code from what the server reports,
    so a track with no people credited simply shows fewer cards rather than empty ones.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/settings_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/credits_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/bottom_nav_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navigation_bar">

        <LinearLayout
            android:id="@+id/credits_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/credits_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    app:cardBackgroundColor="@color/searchBarBackground"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/credits_cover"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/album_cover"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_cover" />

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:id="@+id/credits_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/sf_pro_semibold"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/onSurfaceColor"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/credits_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/sf_pro_regular"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:textColor="@color/onSurfaceColorInactive"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/credits_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:fontFamily="@font/sf_pro_regular"
                android:gravity="center"
                android:includeFontPadding="false"
                android:textColor="@color/onSurfaceColorInactive"
                android:textSize="14sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/credits_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <uk.akane.accord.ui.components.NavigationBar
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:hasReturnButton="true"
        app:layout_constraintTop_toTopOf="parent"
        app:title="@string/popup_view_credits" />

    <uk.akane.cupertino.widget.special.CupertinoActivityIndicatorView
        android:id="@+id/credits_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_bar" />

</androidx.constraintlayout.widget.ConstraintLayout>
