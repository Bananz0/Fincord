<?xml version="1.0" encoding="utf-8"?><!--
    A row, not a card. These sit inside the account card, and giving each one its own filled
    background stacked a third surface on top of the card on top of the page - three greys a shade
    apart, which reads as clutter rather than as structure.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:minHeight="60dp"
    android:paddingHorizontal="18dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_login_avatar"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_person_small" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:textColor="@color/onSurfaceColor"
        android:textSize="17sp" />

    <ImageView
        android:id="@+id/selected"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginStart="12dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_checkmark"
        app:tint="@color/accentColor"
        android:visibility="invisible" />
</LinearLayout>
