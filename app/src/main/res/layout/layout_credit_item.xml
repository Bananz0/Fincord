<?xml version="1.0" encoding="utf-8"?>
<!--
    One credited name inside a section card. The thumbnail is hidden unless the server has a picture
    for that person, so the technical rows - which never do - line up flush with the card edge.
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/credit_thumbnail"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginVertical="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.Accord.Credit.Thumbnail" />

    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="start|center_vertical"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp"
        app:layout_constraintBottom_toTopOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/credit_thumbnail"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/credit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_medium"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/onSurfaceColor"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/credit_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sf_pro_regular"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="@color/onSurfaceColorInactive"
            android:textSize="13sp" />

    </LinearLayout>

    <View
        android:id="@+id/divider"
        android:layout_width="0dp"
        android:layout_height="0.5dp"
        android:background="@color/bottomNavigationDividerColor"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/content_container" />

</androidx.constraintlayout.widget.ConstraintLayout>
