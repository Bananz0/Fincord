    <color name="red">#ff3b30</color>
    <color name="secondaryOverlayColor">#26ffffff</color>
    <color name="secondaryOverlayShadeColor">#33ffffff</color>
    <color name="settings_background">#f3f2f8</color>
    <color name="settings_card_background">#ffffff</color>
    <color name="standardOverlayColor">#ffffff</color>
    <color name="standardOverlayShadeColor">#d9ffffff</color>
    <color name="switch_track_off">#d9d9d9</color>
    <color name="switch_track_on">@color/systemGreen</color>
    <color name="tertiaryOverlayColor">#0dffffff</color>
    <color name="tertiaryOverlayShadeColor">#1affffff</color>
