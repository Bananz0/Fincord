<?xml version="1.0" encoding="utf-8"?>
<!--
    Colour tokens from the upstream Accord UI.
    Kept in their own file so they stay clearly separated from this fork's original palette
    in colors.xml, which existing layouts still reference.
-->
<resources>
    <color name="addMusicHeaderBackground">#f2f2f7</color>
    <color name="black">#ff000000</color>
    <color name="closeButtonBackground">#d1d1d1</color>
    <color name="color_on_surface">#000000</color>
