    <color name="dialog_message">#7a7a7a</color>
    <color name="frontShadeColor">#59000000</color>
    <color name="light_elevated_container">#f2f2f7</color>
    <color name="light_elevated_container_child">#ffffff</color>
    <color name="onSurfaceColorSolid">#000000</color>
    <color name="popupMenuColorDodge">#383838</color>
    <color name="popupMenuLargeSeparator">#14000000</color>
