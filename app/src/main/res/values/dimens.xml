    <!-- The output picker's volume bar, matching the player's own volume row. -->
    <dimen name="output_volume_slider_height">32dp</dimen>

    <!--
        One height for the whole list, chosen from the most detailed row in it.

        Sizing each row to its own contents made a list of pills of three different heights, which
        reads as three different kinds of control rather than one list. The taller row is the one
        carrying "Bluetooth audio" and a codec badge, so when any destination shows those, every
        destination is that tall and the extra space is simply space. The corner radius never
        changes - a row that rounded differently because it happened to know more about itself was
        the same mistake in another form.
    -->
    <dimen name="output_row_height_compact">46dp</dimen>
    <dimen name="output_row_height_subtitle">54dp</dimen>
    <dimen name="output_row_height_badge">68dp</dimen>

