<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Portable UI/playback preferences are the backup. Library and lyric data are rebuilt. -->
    <include domain="sharedpref" path="." />

    <!-- Keystore-backed values cannot be decrypted after restore; plaintext fallbacks are secrets. -->
    <exclude domain="sharedpref" path="jellyfin_credentials.xml" />
    <exclude domain="sharedpref" path="jellyfin_credentials_plain.xml" />
    <exclude domain="sharedpref" path="lidarr_credentials.xml" />
    <exclude domain="sharedpref" path="lidarr_credentials_plain.xml" />
    <exclude domain="sharedpref" path="spotify_credentials.xml" />
    <exclude domain="sharedpref" path="spotify_credentials_plain.xml" />
    <exclude domain="sharedpref" path="lastfm_credentials.xml" />
    <exclude domain="sharedpref" path="lastfm_credentials_plain.xml" />
</full-backup-content>
